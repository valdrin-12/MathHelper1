PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://mathhelper:mathhelper_password@localhost:5432/mathhelper_db
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
MAX_IMAGE_SIZE_MB=4

# In-App Purchase Validation (leave empty for dev mode - validation will be skipped)
# Apple: Get from App Store Connect → Your App → App Information → Shared Secret
APPLE_SHARED_SECRET=
# Google: Base64-encoded service account JSON from Google Play Console
GOOGLE_SERVICE_ACCOUNT_JSON=
# Android package name (defaults to com.valdrin.mathhelper)
ANDROID_PACKAGE_NAME=com.valdrin.mathhelper
