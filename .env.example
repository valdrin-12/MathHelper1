# Public values: they end up inside the app bundle. Secrets belong in backend/.env, never here.

# Backend API URL (the app falls back to the production API when this is empty)
EXPO_PUBLIC_API_URL=

# Image size limit in MB (frontend validation)
EXPO_PUBLIC_MAX_IMAGE_SIZE_MB=4

# Paddle checkout on the web (client-side token and price ids are public by design)
EXPO_PUBLIC_PADDLE_ENV=
EXPO_PUBLIC_PADDLE_CLIENT_TOKEN=
EXPO_PUBLIC_PADDLE_PRICE_MONTHLY=
EXPO_PUBLIC_PADDLE_PRICE_YEARLY=
